        },
        {
          "name": "24. Add loyalty points",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId}}/loyalty/points?points=50&reference=Pedido%20teste",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customerId}}", "loyalty", "points"],
