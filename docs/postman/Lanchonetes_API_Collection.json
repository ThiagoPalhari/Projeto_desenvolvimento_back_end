            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unidade Centro\",\n  \"cnpj\": \"12345678000199\",\n  \"address\": \"Rua das Flores, 100\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/units",
              "host": ["{{baseUrl}}"],
              "path": ["api", "units"]
