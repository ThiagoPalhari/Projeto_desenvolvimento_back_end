              "raw": "{{baseUrl}}/api/products/menu/{{unitId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "menu", "{{unitId}}"]
            }
          }
        },
        {
          "name": "10. Set product availability",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}/units/{{unitId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}", "units", "{{unitId}}", "availability"]
            }
          }
        },
        {
          "name": "11. Create stock movement",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitId\": \"{{unitId}}\",\n  \"productId\": \"{{productId}}\",\n  \"type\": \"IN\",\n  \"quantity\": 20,\n  \"reference\": \"Ajuste inicial\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock/movements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock", "movements"]
            }
          }
        },
        {
          "name": "12. Get stock by unit and product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
