            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/units",
              "host": ["{{baseUrl}}"],
              "path": ["api", "units"]
            }
          }
        }
      ]
    },
    {
      "name": "Produtos e Estoque",
      "item": [
        {
          "name": "07. Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.text();",
                  "if (response && response.includes('id')) {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) { pm.collectionVariables.set('productId', json.id); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X-Burger\",\n  \"description\": \"Hambúrguer artesanal com queijo\",\n  \"price\": 29.90\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "08. List products",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
